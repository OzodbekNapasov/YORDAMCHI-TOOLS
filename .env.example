# ============================================================
#  ATLAS — muhit o'zgaruvchilari namunasi
#  Nusxa oling: .env (lokal kompyuter) va Vercel -> Settings -> Environment Variables.
#  Haqiqiy qiymatlarni HECH QACHON kodga yoki gitga yozmang: repozitoriy ochiq.
# ============================================================

# Asosiy Telegram bot tokeni (@BotFather -> /revoke bilan yangilangan token)
BOT_TOKEN=your_telegram_bot_token_here

# Instagram AutoPoster boti tokeni (berilmasa, panel sozlamasi yoki BOT_TOKEN ishlatiladi)
INSTA_BOT_TOKEN=

# ATLAS veb-paneli admin paroli (login: Ozodbek). Majburiy, aks holda panelga kirib bo'lmaydi.
ATLAS_ADMIN_PASSWORD=

# Ixtiyoriy: sessiya imzolash kaliti va webhook siri. Berilmasa BOT_TOKEN'dan hosil qilinadi.
ATLAS_SECRET_KEY=
TELEGRAM_WEBHOOK_SECRET=

# Meta Ads (Facebook) access token
META_ACCESS_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Ixtiyoriy: /api/instagram/cron_tick himoyasi
CRON_SECRET=
